NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
STRIPE_SECRET_KEY=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Agente editorial de noticias. Solo consume RSS/API autorizadas; no rastrea HTML.
# Ejemplo: [{"id":"asipona","name":"ASIPONA Manzanillo","homepageUrl":"https://www.puertomanzanillo.com.mx","feedUrl":"https://URL-RSS-OFICIAL","trusted":true,"autoPublish":true,"allowsImage":false}]
NEWS_RSS_SOURCES=[]
# Descubrimiento opcional: solo títulos/enlaces de Google News RSS; todo queda en draft.
NEWS_ENABLE_GOOGLE_DISCOVERY=false
NEWS_CRON=*/30 * * * *
NEWS_RUN_ON_START=false
NEWS_AUTO_PUBLISH_SCORE=70
NEWS_REJECT_SCORE=18
# Fallback opcional para un proveedor API con licencia.
NEWS_API_ENDPOINT=
NEWS_API_TOKEN=
NEWS_API_SOURCE_NAME=
NEWS_API_HOMEPAGE=
NEWS_API_TRUSTED=false
NEWS_API_AUTO_PUBLISH=false
NEWS_API_ALLOWS_IMAGE=false

# Extracción opcional de campos en documentos. Sin estas variables queda desactivada.
DOCUMENT_EXTRACTION_PROVIDER=
DOCUMENT_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Correo transaccional de recepción y resolución del expediente. Sin proveedor queda registrado como no enviado.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=Faro Portuario <no-reply@tu-dominio.com>

# Moderación de texto e imágenes de Comunidad. El webhook debe responder
# {"safe":true,"categories":{}} o {"safe":false,"categories":{"sexual":true},"reason":"..."}.
# Categorías: death_gore, sexual, exploitation, sensitive.
# Sin proveedor o ante cualquier error, el contenido queda en pending_review.
COMMUNITY_MODERATION_PROVIDER=
COMMUNITY_MODERATION_URL=
COMMUNITY_MODERATION_TOKEN=
